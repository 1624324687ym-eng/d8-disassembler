dcheck_always_on = false
is_component_build = false
is_debug = false
target_cpu = "x64"
use_custom_libcxx = true
v8_monolithic = false
v8_use_external_startup_data = true

v8_static_library = true
v8_enable_disassembler = true
v8_enable_object_print = true
v8_enable_sandbox = true
v8_enable_pointer_compression = true
v8_enable_pointer_compression_shared_cage = true
v8_enable_external_code_space = true

# Match Electron 43.4.1's V8 build args (build/args/all.gn) so object
# layouts and read-only static-root addresses match the producer build
v8_promise_internal_field_count = 1
v8_enable_javascript_promise_hooks = true
v8_enable_snapshot_native_code_counters = false
v8_enable_private_mapping_fork_optimization = true

# Producer build (jsc RO checksum 0xe8adc8e4, 33+ RO pages) has no static roots
v8_enable_static_roots = false

treat_warnings_as_errors = false
